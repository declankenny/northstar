-- northstar: rebuild
-- Locale: the ref_locales catalog, the locale of each user and the default for new users. See docs/design/locale.md.
-- Run with foreign keys off, because SQLite refuses to add a column that has a REFERENCES clause and a non-null default while
-- they are on. The runner checks the foreign keys and the integrity before it commits and turns them on again.
--
-- The rows below are generated by scripts/generate_locales.py from CLDR @@CLDR@@, with Northstar's own rules: groups of three
-- digits, grouping from four digits and an ASCII minus (see the design). Do not edit them by hand: change the tool and run it
-- again in a new migration. Characters outside printable ASCII are written as char(n) so the SQL can be read:
@@NOTES@@
-- CLDR is distributed under the Unicode License V3. See THIRD_PARTY_NOTICES.md.

CREATE TABLE ref_locales (
    -- The BCP 47 tag. A text key because it is already the identifier in preferences and the API. Shipped tags are stable.
    tag                   TEXT PRIMARY KEY NOT NULL CHECK (length(tag) BETWEEN 2 AND 35),
    -- What a person chooses from, in English.
    label                 TEXT NOT NULL CHECK (length(label) BETWEEN 1 AND 100),
    decimal_mark          TEXT NOT NULL CHECK (length(decimal_mark) = 1),
    group_mark            TEXT NOT NULL CHECK (length(group_mark) = 1 AND group_mark != decimal_mark),
    -- Pieces: {year} {month} {month2} {month_short} {day} {day2}, plus literal text. Month names are English.
    date_template         TEXT NOT NULL CHECK (length(date_template) BETWEEN 1 AND 100),
    currency_position     TEXT NOT NULL CHECK (currency_position IN ('prefix', 'suffix')),
    -- The exact text between an alphabetic currency code and the number.
    currency_code_spacing TEXT NOT NULL CHECK (length(currency_code_spacing) <= 3),
    cldr_version          TEXT NOT NULL CHECK (length(cldr_version) >= 1)
);

INSERT INTO ref_locales
    (tag, label, decimal_mark, group_mark, date_template, currency_position, currency_code_spacing, cldr_version) VALUES
@@ROWS@@;

-- A person's choice. Existing users keep the display they have always had, US English. The application writes the value
-- explicitly for a new or reactivated user, from ui.locale.default, so the default here is only a fallback.
ALTER TABLE users ADD COLUMN locale TEXT NOT NULL DEFAULT 'en-US' REFERENCES ref_locales (tag);

-- The locale a new or reactivated user starts with. A String checked against the catalog by the catalog_locale validator, which
-- does not lock it: an admin can change it later and it affects only users added afterwards.
INSERT INTO system_properties (name, data_type_id, value, allow_null, hint, created_by, updated_by)
SELECT 'ui.locale.default', (SELECT id FROM ref_property_data_types WHERE name = 'String'), 'en-US', 0,
       'Number and date format for new or reactivated users. Changing this does not change other users'' saved preferences.',
       (SELECT id FROM users WHERE is_system = 1), (SELECT id FROM users WHERE is_system = 1);

INSERT INTO ref_property_validators (property_id, validator, position)
    SELECT id, 'catalog_locale', 1 FROM system_properties WHERE name = 'ui.locale.default';

-- A display preference, like the theme: not logged.
INSERT INTO sys_audited_fields (tablename, fieldname, is_logged) VALUES ('users', 'locale', 0);
