{
  "_about": "Hand-written test vectors for locale parsing and formatting, read by pytest (tests/test_locales.py) and vitest (frontend/src/locale.test.ts). The expected results are written by a person, not generated, so a mistake in the generator or the table cannot copy itself into the tests. The 'locales' block is the convention each vector assumes; a test fails if it differs from the migrated ref_locales rows.",
  "locales": {
    "en-US": {"decimal_mark": ".", "group_mark": ",", "date_template": "{month_short} {day}, {year}", "currency_position": "prefix", "currency_code_spacing": "\u00a0"},
    "en-GB": {"decimal_mark": ".", "group_mark": ",", "date_template": "{day} {month_short} {year}", "currency_position": "prefix", "currency_code_spacing": "\u00a0"},
    "de-DE": {"decimal_mark": ",", "group_mark": ".", "date_template": "{day2}.{month2}.{year}", "currency_position": "suffix", "currency_code_spacing": "\u00a0"},
    "fr-FR": {"decimal_mark": ",", "group_mark": "\u202f", "date_template": "{day} {month_short} {year}", "currency_position": "suffix", "currency_code_spacing": "\u00a0"},
    "de-CH": {"decimal_mark": ".", "group_mark": "\u2019", "date_template": "{day2}.{month2}.{year}", "currency_position": "prefix", "currency_code_spacing": "\u00a0"},
    "ja-JP": {"decimal_mark": ".", "group_mark": ",", "date_template": "{year}/{month2}/{day2}", "currency_position": "prefix", "currency_code_spacing": "\u00a0"}
  },
